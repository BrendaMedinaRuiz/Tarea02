<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="COMPRAR BOLETOS"
            android:textSize="24sp"
            android:textColor="#FFD700"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- Nombre del cliente -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del cliente:"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Escribe tu nombre"
            android:inputType="textPersonName"
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:background="#16213E"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Selección de película -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selecciona la película:"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgPelicula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#16213E"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbKids"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cars - Aniversario - $75.00"
                android:textSize="16sp"
                android:textColor="#FFFFFF"/>

            <RadioButton
                android:id="@+id/rbMarvel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Avengers - End game - $80.00"
                android:textSize="16sp"
                android:textColor="#FFFFFF"/>

            <RadioButton
                android:id="@+id/rbComedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Coyote vs Acme - $70.00"
                android:textSize="16sp"
                android:textColor="#FFFFFF"/>
        </RadioGroup>

        <!-- Cantidad de boletos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cantidad de boletos:"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etCantidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: 2"
            android:inputType="number"
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:background="#16213E"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Extras -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Extras:"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#16213E"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <CheckBox
                android:id="@+id/cbPalomitas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Palomitas grandes (+$45.00)"
                android:textSize="16sp"
                android:textColor="#FFFFFF"/>

            <CheckBox
                android:id="@+id/cbRefresco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Refresco (+$35.00)"
                android:textSize="16sp"
                android:textColor="#FFFFFF"/>

            <CheckBox
                android:id="@+id/cbNachos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nachos con queso (+$55.00)"
                android:textSize="16sp"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Botones -->
        <Button
            android:id="@+id/btnConfirmar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" CONFIRMAR COMPRA"
            android:textSize="18sp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnRegresar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REGRESAR A CARTELERA"
            android:textSize="18sp"
            android:backgroundTint="#757575"
            android:textColor="#FFFFFF"
            android:padding="16dp"/>

    </LinearLayout>
</ScrollView>